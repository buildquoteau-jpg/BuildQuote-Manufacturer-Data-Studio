# BuildQuote Data Studio — Environment Variables
# Copy to .env.local and fill in values. Never commit real credentials.

# Supabase (Data Studio staging project — NOT production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local extraction harness safety flag.
# Set to true ONLY in your local .env.local — NEVER in production or CI.
# Required by scripts/extract-local-pdf.mjs to write extraction rows via service role.
LOCAL_ONLY_ALLOW_SERVICE_ROLE=

# Cloudflare R2 (source document storage)
# These must NEVER be exposed to the browser or client bundle — server-side only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_SOURCE_DOCUMENTS=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Cloudflare R2 (backups) — separate bucket, private, no public URL
CLOUDFLARE_R2_BUCKET_BACKUPS=buildquote-backups

# Supabase backup connection strings (scripts/backup/backup_supabase.py)
# Find these in Supabase dashboard → Project Settings → Database → Connection string (URI mode)
# Use the "Direct connection" URI (not pooler) so pg_dump works correctly.
BACKUP_DB_URL_DATA_STUDIO=postgresql://postgres:PASSWORD@localhost:54322/postgres
BACKUP_DB_URL_PRODUCTION=postgresql://postgres.oxvhmulxuvlfjyjzleki:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Production Supabase (RFQ/MFP project — oxvhmulxuvlfjyjzleki)
# Used ONLY by the publish job (apps/web/lib/studio-admin/publish.ts) to write
# approved manufacturers/systems/components into the live customer-facing
# catalogue. Server-side only — NEVER prefix with NEXT_PUBLIC_, never expose
# to the browser bundle, never use for anything other than the publish job.
PRODUCTION_SUPABASE_URL=https://oxvhmulxuvlfjyjzleki.supabase.co
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=

# Hybrid publishing (Library V7)
# Enables manufacturer instant publish (publishCardLive) without the admin
# approval queue. Set to true to allow; unset/false re-imposes approval.
LIVE_PUBLISH_BYPASS_APPROVAL=true
# Shared secret for v6's /api/revalidate-card endpoint (same value in the
# Build-Quote-v6 Vercel project).
REVALIDATE_SECRET=
# Public origin of the live library (override for local v6 testing,
# e.g. http://localhost:3000).
BUILDQUOTE_PUBLIC_ORIGIN=https://buildquote.com.au

# Admin workspace gate (POST /api/admin/workspace-gate)
# Second factor a buildquote_admin must type before entering a manufacturer
# workspace. Required — the endpoint returns 503 while it is unset.
ADMIN_WORKSPACE_GATE_PASSWORD=

# AI / LLM
ANTHROPIC_API_KEY=

# Docling service (self-hosted or API)
DOCLING_API_URL=
DOCLING_API_KEY=
