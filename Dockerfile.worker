# BuildQuote Data Studio — Always-On Cloud Pipeline Worker
# Runs scripts/worker/pipeline_worker.py (pymupdf4llm PDF extraction + AI identity & knowledge parsers + URL fetch + embeddings).
# Fast, compact (~250 MB image, ~60 MB idle RAM, ~100 MB peak) — never OOMs on large catalogues.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PDF_EXTRACTOR=pymupdf

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-worker.txt ./
RUN pip install -r requirements-worker.txt

# Copy only what the worker needs (scripts + prompts)
COPY scripts ./scripts
COPY prompts ./prompts

# Ensure writable working directory for transient per-job files (cleaned after each job)
RUN mkdir -p /app/.local/pipeline-temp /app/.local/docling-output /app/.local/parser-dry-run

CMD ["python", "-u", "scripts/worker/pipeline_worker.py"]
